# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Tatum (https://dashboard.tatum.io) ---
TATUM_API_KEY=
# Sui RPC, served through the Tatum gateway:
TATUM_SUI_RPC_URL=https://sui-testnet.gateway.tatum.io

# --- Network ---
SUI_NETWORK=testnet

# --- Walrus testnet HTTP endpoints ---
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# --- Seal spike (testnet keypair ONLY — never a mainnet key) ---
# bech32 string, e.g. suiprivkey1... — export with: sui keytool export --key-identity <addr>
SUI_PRIVATE_KEY=
