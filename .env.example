# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Tatum (https://dashboard.tatum.io) ---
# REQUIRED: You must create a free account at tatum.io to get an API key.
# Without this, the RPC and Data API calls in spikes and keeper will fail.
TATUM_API_KEY=
# Sui RPC, served through the Tatum gateway:
TATUM_SUI_RPC_URL=https://sui-testnet.gateway.tatum.io

# --- Network ---
SUI_NETWORK=testnet

# --- Walrus testnet HTTP endpoints ---
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# --- Seal ---
# Comma-separated verified testnet key-server object ids (Mysten, 2-of-2).
# Source: MystenLabs/seal docs/content/UsingSeal.mdx. Verify before mainnet use.
SEAL_KEY_SERVER_OBJECT_IDS=0x73d05d62c18d9374e3ea529e8e0ed6161da1a141a94d3f76ae3fe4e99356db75,0xf5d14a81a982144ae441cd7d64b09027f116a468bd36e7eca494f750591623c8
# Seal system package id (needed in M3 for seal_approve): testnet
# 0x8d90881fc48eb30d4422db68083b49e7d0f879658444e3a0ed85ce47feaa54b2

# --- Keys ---
# REQUIRED: Testnet keypair ONLY — never a mainnet key. Needed for Keeper and Spike transactions.
# bech32 string, e.g. suiprivkey1... — export with: sui keytool export --key-identity <addr>
SUI_PRIVATE_KEY=

# --- Veil ---
VEIL_PACKAGE_ID=0x67b75f6c83a888d8736f47297c1a2e7212e8d8b8b4d1062aace46d024d22e30c
